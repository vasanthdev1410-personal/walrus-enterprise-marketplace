{
  "name": "@walrus/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "lint": "eslint . --max-warnings=0",
    "start": "next start --port 3000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walrus/types": "workspace:*",
    "@walrus/ui": "workspace:*",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "@walrus/eslint-config": "workspace:*",
    "@walrus/tsconfig": "workspace:*",
    "eslint": "10.10.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
