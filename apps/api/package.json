{
  "name": "@walrus/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint src test prisma.config.ts --max-warnings=0",
    "prisma:validate": "prisma validate",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "1.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/node": "10.69.0",
    "@walrus/config": "workspace:*",
    "@walrus/shared": "workspace:*",
    "@walrus/types": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "express": "5.1.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.8",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
