    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "@types/pg": "8.20.4",
    "@types/supertest": "7.2.1",
    "@walrus/eslint-config": "workspace:*",
    "@walrus/tsconfig": "workspace:*",
    "eslint": "10.8.0",
    "jest": "29.7.0",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
