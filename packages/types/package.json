{
  "name": "@walrus/types",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run src --passWithNoTests",
    "test:coverage": "vitest run src --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "@walrus/eslint-config": "workspace:*",
    "@walrus/tsconfig": "workspace:*",
    "eslint": "10.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
