# Ownership: Platform Team
APP_NAME=WALRUS Enterprise Marketplace
APP_ENV=local
APP_VERSION=1.0.0
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000/api/v1
# The web client MUST stay same-origin: it calls /api/v1 on the web origin and
# Next.js proxies server-side (next.config.ts rewrites). The CSP
# connect-src 'self' blocks cross-origin fetches, so never set
# NEXT_PUBLIC_API_BASE_URL to the API origin. Only same-origin values such as
# /api/v1 (default) or a reverse-proxied origin (e.g. http://localhost:8080/api/v1
# when nginx serves both web and API) are supported.
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Ownership: Backend Team
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=walrus
DATABASE_USER=walrus
DATABASE_PASSWORD=replace-with-local-password
DATABASE_SSL=false
DATABASE_URL=postgresql://walrus:replace-with-local-password@localhost:5432/walrus?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-password
REDIS_DB=0

# Ownership: Platform Team
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
METRICS_ENABLED=true
TRACE_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Future integrations; optional in Module 00
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
AWS_REGION=

# Module 01 Identity & Authentication references (Phase 2; no secret material)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SIGNING_KEY_ID=
JWT_SIGNING_KEY_REFERENCE=
JWT_VERIFICATION_KEY_SET_REFERENCE=
REFRESH_TOKEN_HMAC_ACTIVE_KEY_VERSION=
REFRESH_TOKEN_HMAC_ACTIVE_KEY_REFERENCE=
REFRESH_TOKEN_HMAC_VERIFICATION_KEY_REFERENCES_JSON={}
OTP_HMAC_ACTIVE_KEY_VERSION=
OTP_HMAC_ACTIVE_KEY_REFERENCE=
OTP_HMAC_VERIFICATION_KEY_REFERENCES_JSON={}
RECOVERY_CODE_HMAC_ACTIVE_KEY_VERSION=
RECOVERY_CODE_HMAC_ACTIVE_KEY_REFERENCE=
RECOVERY_CODE_HMAC_VERIFICATION_KEY_REFERENCES_JSON={}
IDENTIFIER_LOOKUP_HMAC_ACTIVE_KEY_VERSION=
IDENTIFIER_LOOKUP_HMAC_ACTIVE_KEY_REFERENCE=
IDENTIFIER_LOOKUP_HMAC_VERIFICATION_KEY_REFERENCES_JSON={}
M01_ENVELOPE_KEK_ACTIVE_VERSION=
M01_ENVELOPE_KEK_ACTIVE_REFERENCE=
M01_ENVELOPE_KEK_DECRYPTION_REFERENCES_JSON={}
CSRF_HMAC_ACTIVE_KEY_VERSION=
